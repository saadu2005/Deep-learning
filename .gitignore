# Purpose: stop generated files and machine-specific files from being committed.
# Real-life example: when sharing this tutorial, other learners should not get
# your local virtual environment, editor settings, model files, or downloaded data.

# Python bytecode created automatically when scripts run.
__pycache__/
*.py[cod]

# Local Python environments installed on one computer.
.venv/
venv/
env/

# Notebook checkpoints and personal editor/project settings.
.ipynb_checkpoints/
.vscode/
.idea/

# Large trained model artifacts that can be regenerated from code and data.
*.h5
*.keras
*.pt
*.pth

# Downloaded datasets; keep the repository small and share a source instead.
datasets/downloads/
